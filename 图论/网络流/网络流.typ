#table(
  columns: (auto, auto),
  align: center,
  table.header([问题特征], [优先考虑模型]),
  [两个集合一对一/多对多，有数量限制], [二分图多重匹配（最大流）],
  [选若干项目，每个项目有收益/成本，依赖关系], [最大权闭合子图（最小割）],
  [有向无环图，用最少路径覆盖所有顶点], [DAG最小路径覆盖（拆点最大流）],
  [网格上选若干不相邻格子，权值和最大], [二分图最大独立集（最小割）],
  [有多条路径，节点/边有使用次数限制], [拆点限流 + 最大流/费用流],
  [运输、调配，有单位成本，求最小费用], [最小费用最大流],
  [数轴上选区间，每点覆盖次数 ≤ k，总长最大], [区间k覆盖模型（费用流）],
  [随时间/状态变化的转移，求最短时间/最小代价], [分层图最短路 或 分层图最大流],
  [已知最大流，求最小割中边数最少的割], [容量放大 + 一次最大流],
