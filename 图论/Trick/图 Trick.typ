#text("建图优化默认原图点数 ")$n$#text(" 与操作数 ")$q$#text(" 可达 ")$10^5$#text(" 量级：目标是让显式边数降到 ")#text("O((n+q) log n)")#text(" 或 ")#text("O(n sqrt n)")#text("。所有中转点与辅助结点都不参与询问，统计答案时必须排除。")

#text("每条先给明确问题模型，再给必要思路与适用条件。参考链接用于追溯知识，应用情景由本文重新整理。")

=== #text("多源与共享代价：拆出超级源点") <trick-graph-01>

*问题概述*　#text("有 ")$k$#text(" 个源点，求每个点到最近源点的距离；朴素做法要跑 ")$k$#text(" 次单源最短路。等价地，若一条边的代价可拆成只与起点有关的部分加上只与终点有关的部分，逐一建边会得到 ")#text("O(kn)")#text(" 条边。")

*必要思路*　#text("建一个不参与询问的超级源点 ")$S$#text("，从 ")$S$#text(" 向每个源点连权 ")$0$#text(" 的边，一次单源最短路即可。边权形如「起点代价 + 终点代价」时同理，把其中一半折进中转点。适用条件是被合并的那部分代价对所有目标点相同；每个源点代价不同就必须各建一个中转点，不能共用一个 ")$S$#text("。")

*参考*　#link("https://oi-wiki.org/graph/shortest-path/")[#text("OI Wiki：最短路")]。

=== #text("点与区间互连：线段树优化建图") <trick-graph-02>

*问题概述*　#text("有 ")$n$#text(" 个点与 ")$q$#text(" 次操作，每次形如「点 ")$u$#text(" 向编号区间 ")$[l,r]$#text(" 内所有点连一条边」或反向。直接连边最坏 ")#text("O(nq)")#text(" 条，需要降到 ")#text("O((n+q) log n)")#text("。")

*必要思路*　#text("用线段树把区间拆成 ")#text("O(log n)")#text(" 个结点，只向这些结点连边。点向区间连边用「出树」（父亲连儿子），区间向点连边用「入树」（儿子连父亲），两棵树的叶子用权 ")$0$#text(" 的边一一对应。边权挂在树边上，因此同一棵树不能同时承担两个方向。")

*参考*　#link("https://oi-wiki.org/ds/seg/")[#text("OI Wiki：线段树基础")]。

==== #text("延伸：为什么必须建两棵线段树")

*延伸问题*　#text("只建一棵线段树，父亲向儿子连权 ")$0$#text(" 的边，同时把「点 → 区间」与「区间 → 点」都接到这棵树上，会出什么问题？")

*必要思路*　#text("「父亲 → 儿子」的 ")$0$#text(" 边让「区间对应结点 → 区间内任一点」免费连通，这正是「区间 → 点」所需的；但它同时让「区间内任一点 → 区间对应结点」也免费连通，于是任何点都能沿 ")$0$#text(" 边走到祖先再下到兄弟，产生原图中不存在的边。把「点 → 区间」改接到方向相反的入树即可切断这条通路。")

*依据*　由定义推导，证明或边界已给出。

=== #text("带版本的区间连边：可持久化线段树") <trick-graph-03>

*问题概述*　#text("连边规则依赖「版本」：第 ")$i$#text(" 次操作建立在前 ")$i-1$#text(" 次的基础上，且允许随时回退到任一历史版本继续连边，每条边只在其版本之后可见。")

*必要思路*　#text("把线段树建成可持久化的：每次修改新增 ")#text("O(log n)")#text(" 个结点，其余结构共享，每个版本对应一个根。版本 ")$i$#text(" 的区间连边从该版本的根出发。注意可持久化后不能再用堆式存储，必须显式记录左右儿子编号。")

*参考*　#link("https://oi-wiki.org/ds/persistent-seg/")[#text("OI Wiki：可持久化线段树")]。

=== #text("前缀链压缩成对约束") <trick-graph-04>

*问题概述*　#text("有 ")$k$#text(" 个布尔变量 ")$x_i$#text("，要求其中恰有一个为真（或至多一个为真），同时每个变量还参与其他二元约束。直接枚举变量对会写出 ")#text("O(k^2)")#text(" 条约束边。")

*必要思路*　#text("引入前缀变量 ")$s_i$#text(" 表示「前 ")$i$#text(" 个变量中已出现真值」，用 ")$s_(i-1) -> s_i$#text("、")$x_i -> s_i$#text("、")$x_i -> not s_(i-1)$#text(" 这三条边族表达「至多一个为真」，共 ")#text("O(k)")#text(" 条；再补一条强制 ")$s_k$#text(" 为真的边即得「恰好一个」。关键是 ")$s_(i-1)$#text(" 与 ")$x_i$#text(" 的矛盾由第三条直接给出，不必枚举变量对。")

*参考*　#link("https://oi-wiki.org/graph/2-sat/")[#text("OI Wiki：2-SAT")]。

=== #text("树上路径连边：树链剖分加线段树") <trick-graph-05>

*问题概述*　#text("每次操作给出一条树上路径 ")$(u,v)$#text("，要求「点 ")$x$#text(" 向路径上所有点连边」或反向。路径长度可达 ")$n$#text("，逐点连边是 ")#text("O(nq)")#text("。")

*必要思路*　#text("先树链剖分，把路径拆成 ")#text("O(log n)")#text(" 条 dfs 序上的连续区间，再对每条区间套用线段树优化建图，于是单次操作只增 ")#text("O(log^2 n)")#text(" 条边。适用条件是根固定；若根会变，剖分结构必须重建。")

*参考*　#link("https://oi-wiki.org/graph/hld/")[#text("OI Wiki：树链剖分")]。

=== #text("点向区间：ST 表优化建图") <trick-graph-06>

*问题概述*　#text("只需要「点 → 区间」这一个方向，且图是 DAG 或可离线，希望单次只增 ")#text("O(1)")#text(" 条边而不是 ")#text("O(log n)")#text(" 条。")

*必要思路*　#text("用 ST 表结点覆盖区间 ")$[l,r]$#text("：取最大的 ")$k$#text(" 使 ")$2^k$#text(" 不超过区间长度，则 ")$[l,l+2^k-1]$#text(" 与 ")$[r-2^k+1,r]$#text(" 两块即可覆盖。因 ST 表允许区间重叠，两块足够。表内结点向长度减半的子区间连权 ")$0$#text(" 的边，叶子为真实点。仅适用于单向区间连边，双向需要两套表。")

*参考*　#link("https://oi-wiki.org/ds/sparse-table/")[#text("OI Wiki：ST 表")]。

==== #text("延伸：为什么 ST 表单次只需两条边")

*延伸问题*　#text("线段树拆区间要 ")#text("O(log n)")#text(" 个结点，ST 表为什么两块就够？")

*必要思路*　#text("线段树要求拆出的结点互不相交，覆盖必须恰好划分区间，所以段数是 ")#text("O(log n)")#text("。ST 表的块允许重叠，只要求「并集等于区间、且每块都完全落在区间内」，取两个长度 ")$2^k$#text(" 的块分别顶住左右端点即可达到此要求。代价是表内必须为所有长度都建结点，结点数是 ")#text("O(n log n)")#text("，比线段树的 ")#text("O(n)")#text(" 多。")

*依据*　由定义推导，证明或边界已给出。

=== #text("分块优化建图") <trick-graph-07>

*问题概述*　#text("同样是点与区间互连，但 ")$n$#text(" 较小而 ")$q$#text(" 很大，或者不希望承担线段树 ")#text("O(log n)")#text(" 的常数。")

*必要思路*　#text("把序列分成 ")#text("O(sqrt n)")#text(" 块：块内向点、点向块内各建一组辅助结点，整块用 ")#text("O(1)")#text(" 条边、碎片逐点连边，单次操作 ")#text("O(sqrt n)")#text(" 条边。适用条件是操作次数不足以让 ")#text("O(log n)")#text(" 的理论优势压过常数。")

*参考*　#link("https://oi-wiki.org/ds/decompose/")[#text("OI Wiki：分块思想")]。

=== #text("矩形邻域连边：K-D Tree 优化建图") <trick-graph-08>

*问题概述*　#text("点带二维坐标，连边条件为「与 ")$(x,y)$#text(" 的曼哈顿距离或切比雪夫距离不超过 ")$d$#text("」，即矩形邻域内的点集。逐对连边是 ")#text("O(n^2)")#text("。")

*必要思路*　#text("把点建成 K-D Tree，每个结点代表一个矩形区域：点向被覆盖的结点连边，结点向子结点连边，单次邻域连边 ")#text("O(sqrt n)")#text(" 条。划分必须保证各结点矩形互不相交，否则会连出原图中不存在的边；建树时按方差最大的维度交替切分。")

*参考*　#link("https://oi-wiki.org/ds/kdt/")[#text("OI Wiki：K-D Tree")]。

=== #text("异或完全图：Trie 上分治或 Boruvka") <trick-graph-09>

*问题概述*　#text("有 ")$n$#text(" 个点，点 ")$u$#text(" 与 ")$v$#text(" 之间的边权取 ")$a_u$#text(" 与 ")$a_v$#text(" 的异或，求最小生成树。完全图有 ")#text("O(n^2)")#text(" 条边，无法显式建出。")

*必要思路*　#text("把所有 ")$a_u$#text(" 插入 01-Trie 后分治：某结点左右子树都非空时，子树内部的边权高位相同，跨子树的边权该位为 ")$1$#text("，因此只需在两侧各取一个元素使异或最小来代表跨边，再递归合并，总复杂度 ")#text("O(n log V)")#text("。同一分治也可换成 Boruvka：每轮对每个连通块用 Trie 求最小出边。")

*参考*　#link("https://oi-wiki.org/string/trie/")[#text("OI Wiki：字典树")]#text("、")#link("https://oi-wiki.org/graph/mst/")[#text("最小生成树")]。

=== #text("差值型完全图：只连排序后的相邻边") <trick-graph-10>

*问题概述*　#text("点 ")$i$#text(" 有权值 ")$a_i$#text("，边权为 ")$|a_i-a_j|$#text("，求最小生成树。完全图边数 ")#text("O(n^2)")#text("。")

*必要思路*　#text("把点按 ")$a$#text(" 排序后只保留相邻两点之间的边，得到的最小生成树与原完全图相同：排序后跨多点的边可被相邻边之和替代，不会更优。注意这条结论只对「差值」这一度量成立，换成异或或乘积都不成立。")

*参考*　#link("https://oi-wiki.org/graph/mst/")[#text("OI Wiki：最小生成树")]。

=== #text("曼哈顿距离完全图 MST 的四向扫描") <trick-graph-11>

*问题概述*　#text("点 ")$i$#text(" 带权值 ")$a_i,b_i$#text("，边权取曼哈顿距离，求最小生成树。")

*必要思路*　#text("把绝对值按符号拆成 ")$4$#text(" 个方向分别扫描：按 ")$a+b$#text(" 或 ")$a-b$#text(" 排序后，用树状数组维护「后缀中 ")$a+b$#text(" 最小的点」，为每个点找出该方向上唯一的候选最近点，四个方向合计 ")#text("O(n)")#text(" 条候选边，再跑 Kruskal。每个方向只需连排名在后的第一个更优点。")

*参考*　#link("https://oi-wiki.org/graph/mst/")[#text("OI Wiki：最小生成树")]。

=== #text("树上距离约束连边：点分治优化建图") <trick-graph-12>

*问题概述*　#text("树上点 ")$u,v$#text(" 之间当且仅当距离不超过 ")$k$#text(" 时连边，这样的边有 ")#text("O(n^2)")#text(" 条。")

*必要思路*　#text("用点分治：在每层的分治中心处，把子树内点到中心的距离当作「中转」结点，同一中心下的点两两经由该中心连边即可。配合双指针或前缀和，边数降到 ")#text("O(n log n)")#text("。必须处理同一子树内的点对被重复计数的问题，做法是减去该子树内部的组合。")

*参考*　#link("https://oi-wiki.org/graph/tree-divide/")[#text("OI Wiki：树分治")]。

=== #text("多组关键点：虚树优化建图") <trick-graph-13>

*问题概述*　#text("多次询问，每次给定一组关键点，关键点总数 ")#text("O(m)")#text("，需要在这组关键点诱导出的原树结构上连边或做 DP，而原树规模 ")$n$#text(" 很大。")

*必要思路*　#text("对每次询问，把关键点按 dfs 序排序，加入两两的最近公共祖先，用单调栈建出虚树，规模只有 ")#text("O(k)")#text("。原树边权需预压缩成两点间距离。适用条件是「非关键点不影响答案」；若路径上的非关键点也参与计算，虚树边必须带上原路径的聚合信息。")

*参考*　#link("https://oi-wiki.org/graph/virtual-tree/")[#text("OI Wiki：虚树")]。

=== #text("网格行列拆点：转成二分图") <trick-graph-14>

*问题概述*　#text("操作针对整行或整列，例如选中第 ")$i$#text(" 行需付 ")$r_i$#text("、选中第 ")$j$#text(" 列需付 ")$c_j$#text("，要求覆盖指定的格子集合；或格子的代价形如 ")$r_i+c_j$#text("。逐格建点会让边数变成 ")#text("O(n^2)")#text("。")

*必要思路*　#text("为每一行、每一列各建一个点，格子 ")$(i,j)$#text(" 对应连接行点 ")$i$#text(" 与列点 ")$j$#text(" 的一条边，于是形成二分图。行列组合问题转为二分图上的匹配或点覆盖，行列连通性问题转为连通块的合并。")

*参考*　#link("https://oi-wiki.org/graph/bi-graph/")[#text("OI Wiki：二分图")]。

=== #text("状态并入点集：拆点与分层图") <trick-graph-15>

*问题概述*　#text("状态除所在结点外，还含「已用掉几次特殊机会」「当前落在哪个模余数」等有限维信息；在状态上直接 DP 会让同一状态被反复转移，或难以处理环。")

*必要思路*　#text("把每个真实结点复制成「结点 × 状态」个点，状态转移变成这些点之间的边，问题直接化为单源最短路。层数等于状态数，总点数是乘法增长，边数是原边数乘状态数。状态维度超过两个时先估内存再动手。")

*参考*　#link("https://oi-wiki.org/graph/node/")[#text("OI Wiki：拆点")]。
